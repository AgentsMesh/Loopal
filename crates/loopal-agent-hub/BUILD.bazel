load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "loopal-agent-hub",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    proc_macro_deps = ["@crates//:async-trait"],
    visibility = ["//visibility:public"],
    deps = [
        "//crates/loopal-agent-client",
        "//crates/loopal-config",
        "//crates/loopal-decision-api",
        "//crates/loopal-git",
        "//crates/loopal-hub-vault",
        "//crates/loopal-ipc",
        "//crates/loopal-mcp",
        "//crates/loopal-output-guard",
        "//crates/loopal-protocol",
        "//crates/loopal-secret-client",
        "//crates/loopal-storage",
        "//crates/loopal-tool-api",
        "//crates/loopal-vault-api",
        "//crates/loopal-view-state",
        "//crates/loopal-workflow-schema",
        "//crates/loopal-workspace",
        "@crates//:anyhow",
        "@crates//:chrono",
        "@crates//:dirs",
        "@crates//:indexmap",
        "@crates//:reqwest",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "loopal-agent-hub-unit-test",
    crate = ":loopal-agent-hub",
    edition = "2024",
    proc_macro_deps = ["@crates//:async-trait"],
    deps = [
        "//crates/loopal-error",
        "//crates/loopal-vault-age",
        "@crates//:indexmap",
        "@crates//:secrecy",
    ],
)

rust_test(
    name = "loopal-agent-hub_test",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/suite.rs",
    data = ["//:loopal"],
    edition = "2024",
    env = {"LOOPAL_BINARY": "$(rootpath //:loopal)"},
    local = True,
    deps = [
        ":loopal-agent-hub",
        "//crates/loopal-agent",
        "//crates/loopal-agent-client",
        "//crates/loopal-agent-server",
        "//crates/loopal-hub-vault",
        "//crates/loopal-ipc",
        "//crates/loopal-output-guard",
        "//crates/loopal-protocol",
        "//crates/loopal-provider-api",
        "//crates/loopal-secret-client",
        "//crates/loopal-storage",
        "//crates/loopal-test-support",
        "//crates/loopal-vault-age",
        "//crates/loopal-vault-api",
        "//crates/loopal-view-state",
        "//crates/loopal-workspace",
        "@crates//:secrecy",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:uuid",
    ],
)
