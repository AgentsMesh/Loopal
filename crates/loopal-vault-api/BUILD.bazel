load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "loopal-vault-api",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    proc_macro_deps = [
        "@crates//:async-trait",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:secrecy",
        "@crates//:serde",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "loopal-vault-api-unit-test",
    crate = ":loopal-vault-api",
    edition = "2024",
    deps = ["@crates//:serde_json"],
)
