load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "loopal-meta-hub",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/loopal-agent-hub",
        "//crates/loopal-ipc",
        "//crates/loopal-protocol",
        "@crates//:anyhow",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:uuid",
    ],
)

# Unit + integration tests (DuplexTransport, no real binary needed)
rust_test(
    name = "loopal-meta-hub_test",
    srcs = ["tests/suite.rs"] + glob(["tests/suite/**/*.rs"]),
    crate_root = "tests/suite.rs",
    edition = "2024",
    proc_macro_deps = ["@crates//:async-trait"],
    deps = [
        ":loopal-meta-hub",
        "//crates/loopal-agent-hub",
        "//crates/loopal-error",
        "//crates/loopal-ipc",
        "//crates/loopal-protocol",
        "@crates//:serde_json",
        "@crates//:tokio",
    ],
)

# End-to-end cluster tests (real binary, real TCP, real agent processes)
# Forced single-threaded: each test spawns ≥1 agent subprocess + Hub + MetaHub
# TCP listener; running them in parallel within one test binary stresses CI
# resources (process tables, fd, port allocation) and causes initialize
# timeouts that look like flakes but are real resource exhaustion.
rust_test(
    name = "loopal-meta-hub_e2e",
    srcs = glob(["tests/e2e/**/*.rs"]),
    crate_root = "tests/e2e/e2e_cluster_test.rs",
    data = ["//:loopal"],
    edition = "2024",
    env = {
        "LOOPAL_BINARY": "$(rootpath //:loopal)",
        "RUST_TEST_THREADS": "1",
    },
    local = True,
    tags = ["exclusive"],
    deps = [
        ":loopal-meta-hub",
        "//crates/loopal-agent-client",
        "//crates/loopal-agent-hub",
        "//crates/loopal-ipc",
        "//crates/loopal-protocol",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:uuid",
    ],
)
