load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "loopal-test-support",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    proc_macro_deps = ["@crates//:async-trait"],
    visibility = ["//visibility:public"],
    deps = [
        "//crates/loopal-agent",
        "//crates/loopal-agent-client",
        "//crates/loopal-agent-server",
        "//crates/loopal-backend",
        "//crates/loopal-config",
        "//crates/loopal-context",
        "//crates/loopal-error",
        "//crates/loopal-ipc",
        "//crates/loopal-kernel",
        "//crates/loopal-protocol",
        "//crates/loopal-provider-api",
        "//crates/loopal-runtime",
        "//crates/loopal-scheduler",
        "//crates/loopal-session",
        "//crates/loopal-storage",
        "//crates/loopal-tool-api",
        "//crates/loopal-turn",
        "@crates//:chrono",
        "@crates//:futures",
        "@crates//:rmcp",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tokio-util",
    ],
)

rust_library(
    name = "mock-llm-server",
    srcs = ["src/mock_llm_server.rs"],
    crate_name = "loopal_mock_llm_server",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/loopal-mock-llm:loopal-mock-llm-lib",
        "@crates//:reqwest",
        "@crates//:serde_json",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "mock-llm-server-test",
    crate = ":mock-llm-server",
    edition = "2024",
)

rust_test(
    name = "loopal-test-support-unit-test",
    crate = ":loopal-test-support",
    edition = "2024",
)
