load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "loopal-backend",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    proc_macro_deps = ["@crates//:async-trait"],
    visibility = ["//visibility:public"],
    deps = [
        "//crates/loopal-config",
        "//crates/loopal-error",
        "//crates/loopal-protocol",
        "//crates/loopal-sandbox",
        "//crates/loopal-tool-api",
        "//crates/loopal-tool-invocation",
        "//crates/tools/filesystem/edit-core:loopal-edit-core",
        "@crates//:base64",
        "@crates//:futures",
        "@crates//:globset",
        "@crates//:ignore",
        "@crates//:parking_lot",
        "@crates//:regex",
        "@crates//:reqwest",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:uuid",
        "@crates//:zeroize",
    ] + select({
        "@platforms//os:windows": ["@crates//:process-wrap"],
        "//conditions:default": ["@crates//:libc"],
    }),
)

rust_test(
    name = "loopal-backend-unit-test",
    crate = ":loopal-backend",
    edition = "2024",
    proc_macro_deps = ["@crates//:async-trait"],
    deps = [
        "//crates/loopal-output-guard",
        "@crates//:secrecy",
    ],
)

rust_test(
    name = "loopal-backend_test",
    srcs = glob(
        ["tests/**/*.rs"],
        exclude = ["tests/suite/process_group_windows_test.rs"],
    ),
    crate_root = "tests/suite.rs",
    edition = "2024",
    proc_macro_deps = ["@crates//:async-trait"],
    deps = [
        ":loopal-backend",
        "//crates/loopal-config",
        "//crates/loopal-error",
        "//crates/loopal-output-guard",
        "//crates/loopal-protocol",
        "//crates/loopal-tool-api",
        "@crates//:parking_lot",
        "@crates//:secrecy",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:uuid",
    ] + select({
        "@platforms//os:windows": ["@crates//:windows-sys"],
        "//conditions:default": ["@crates//:libc"],
    }),
)

rust_test(
    name = "process_group_windows_test",
    srcs = ["tests/suite/process_group_windows_test.rs"],
    crate_root = "tests/suite/process_group_windows_test.rs",
    edition = "2024",
    target_compatible_with = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":loopal-backend",
        "@crates//:tokio",
        "@crates//:windows-sys",
    ],
)
