load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "loopal-tool-fetch",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    proc_macro_deps = ["@crates//:async-trait"],
    visibility = ["//visibility:public"],
    deps = [
        "//crates/loopal-config",
        "//crates/loopal-error",
        "//crates/loopal-tool-api",
        "@crates//:html2text",
        "@crates//:schemars",
        "@crates//:serde",
        "@crates//:tracing",
    ],
)

rust_test(
    name = "loopal-tool-fetch-unit-test",
    crate = ":loopal-tool-fetch",
    edition = "2024",
)

rust_test(
    name = "loopal-tool-fetch-test",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/fetch_test.rs",
    edition = "2024",
    proc_macro_deps = ["@crates//:async-trait"],
    deps = [
        ":loopal-tool-fetch",
        "//crates/loopal-backend",
        "//crates/loopal-config",
        "//crates/loopal-error",
        "//crates/loopal-tool-api",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)
