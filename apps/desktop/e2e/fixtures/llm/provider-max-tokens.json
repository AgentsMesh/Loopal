    },
    {
      "expect": { "bodyContains": "PARTIAL MAX TOKEN OUTPUT" },
      "chunks": [
        { "type": "text", "text": "Continuation completed over a second HTTP request." },
        { "type": "usage", "input": 30, "output": 10 },
        { "type": "done" }
      ]
    }
  ]
}
