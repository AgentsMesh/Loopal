load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "loopal-agent-server",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/loopal-agent",
        "//crates/loopal-classifier",
        "//crates/loopal-config",
        "//crates/loopal-context",
        "//crates/loopal-decision-api",
        "//crates/loopal-error",
        "//crates/loopal-ipc",
        "//crates/loopal-kernel",
        "//crates/loopal-mcp",
        "//crates/loopal-memory",
        "//crates/loopal-provider-api",
        "//crates/loopal-protocol",
        "//crates/loopal-runtime",
        "//crates/loopal-scheduler",
        "//crates/loopal-secret-client",
        "//crates/loopal-secret-runtime",
        "//crates/loopal-storage",
        "//crates/loopal-tool-api",
        "//crates/loopal-turn",
        "//crates/loopal-vault-api",
        "//crates/tools/process/background:loopal-tool-background",
        "@crates//:anyhow",
        "@crates//:futures",
        "@crates//:parking_lot",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:tokio-util",
        "@crates//:tracing",
    ],
    proc_macro_deps = ["@crates//:async-trait"],
)

rust_test(
    name = "loopal-agent-server-unit-test",
    crate = ":loopal-agent-server",
    edition = "2024",
    deps = ["@crates//:chrono"],
)

rust_test(
    name = "loopal-agent-server_test",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/suite.rs",
    edition = "2024",
    local = True,
    deps = [
        ":loopal-agent-server",
        "//crates/loopal-agent",
        "//crates/loopal-config",
        "//crates/loopal-decision-api",
        "//crates/loopal-error",
        "//crates/loopal-ipc",
        "//crates/loopal-kernel",
        "//crates/loopal-mcp",
        "//crates/loopal-protocol",
        "//crates/loopal-provider-api",
        "//crates/loopal-runtime",
        "//crates/loopal-scheduler",
        "//crates/loopal-test-support",
        "//crates/loopal-tool-api",
        "//crates/loopal-turn",
        "//crates/loopal-backend",
        "//crates/tools/process/background:loopal-tool-background",
        "//crates/tools/process/bash:loopal-tool-bash",
        "@crates//:chrono",
        "@crates//:indexmap",
        "@crates//:rmcp",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:tokio-util",
        "@crates//:uuid",
    ],
    proc_macro_deps = ["@crates//:async-trait"],
)
