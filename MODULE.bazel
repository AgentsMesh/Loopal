module(
    name = "loopal",
    version = "0.3.0",
)

# Bazel skylib
bazel_dep(name = "bazel_skylib", version = "1.8.2")

# Platforms (needed for cross-compilation platform() targets)
bazel_dep(name = "platforms", version = "1.0.0")

# TypeScript / Electron desktop. pnpm resolves the external graph; Bazel owns
# every build, test, coverage, E2E, and packaging action.
bazel_dep(name = "aspect_bazel_lib", version = "2.19.2")
bazel_dep(name = "aspect_rules_js", version = "2.9.2")
bazel_dep(name = "aspect_rules_ts", version = "3.8.3")
bazel_dep(name = "rules_nodejs", version = "6.3.3")

rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")
rules_ts_ext.deps(ts_version = "5.9.3")
use_repo(rules_ts_ext, "npm_typescript")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.12.0")
use_repo(node, "nodejs_toolchains")

register_toolchains("@nodejs_toolchains//:all")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    custom_postinstalls = {"electron@43.1.0": "node install.js"},
    data = [
        "//:package.json",
        "//:pnpm-workspace.yaml",
    ],
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

# Rust rules
bazel_dep(name = "rules_rust", version = "0.69.0")

# Patch rules_rust to fix Windows PATH length overflow (bazelbuild/rules_rust#3767).
# The process_wrapper consolidates hundreds of -Ldependency= paths into a single
# temporary directory via hard links, keeping PATH under the 32,767-char Win32 limit.
# Safe to remove once upstream merges commits eb70659c + 22830c79.
# The collector patch backports rules_rust commit 0a59de57's failed-export handling,
# cleans its temporary profile on failure, and works around Bazel #28310 by restoring
# owner-write permission before split coverage post-processing.
single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = [
        "//patches:rules_rust_coverage_fail_closed.patch",
        "//patches:rules_rust_windows_consolidate_deps.patch",
    ],
    version = "0.69.0",
)

# Rust toolchain
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")

# Keep the release compiler on Rust 1.94. Branch coverage uses separate
# producer/collector toolchains because LLVM 21.1.8 has an upstream
# getInstantiationGroups crash for async/generic branch maps. These native-host
# sets are selected only by //:rust_branch_toolchain, so ordinary builds and
# tests never resolve them.
rust.repository_set(
    name = "rust_branch_macos_aarch64",
    edition = "2024",
    exec_triple = "aarch64-apple-darwin",
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
    target_settings = ["//:rust_branch_toolchain_enabled"],
    target_triple = "aarch64-apple-darwin",
    urls = [
        "https://static.rust-lang.org/dist/{}.tar.xz",
        "https://mirrors.sjtug.sjtu.edu.cn/rust-static/dist/{}.tar.xz",
        "https://mirrors.ustc.edu.cn/rust-static/dist/{}.tar.xz",
    ],
    versions = ["1.92.0"],
)
rust.repository_set(
    name = "rust_branch_macos_x86_64",
    edition = "2024",
    exec_triple = "x86_64-apple-darwin",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:osx",
    ],
    target_settings = ["//:rust_branch_toolchain_enabled"],
    target_triple = "x86_64-apple-darwin",
    urls = [
        "https://static.rust-lang.org/dist/{}.tar.xz",
        "https://mirrors.sjtug.sjtu.edu.cn/rust-static/dist/{}.tar.xz",
        "https://mirrors.ustc.edu.cn/rust-static/dist/{}.tar.xz",
    ],
    versions = ["1.92.0"],
)
rust.repository_set(
    name = "rust_branch_linux_x86_64",
    edition = "2024",
    exec_triple = "x86_64-unknown-linux-gnu",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    target_settings = ["//:rust_branch_toolchain_enabled"],
    target_triple = "x86_64-unknown-linux-gnu",
    urls = [
        "https://static.rust-lang.org/dist/{}.tar.xz",
        "https://mirrors.sjtug.sjtu.edu.cn/rust-static/dist/{}.tar.xz",
        "https://mirrors.ustc.edu.cn/rust-static/dist/{}.tar.xz",
    ],
    versions = ["1.92.0"],
)
rust.repository_set(
    name = "rust_branch_linux_aarch64",
    edition = "2024",
    exec_triple = "aarch64-unknown-linux-gnu",
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    target_settings = ["//:rust_branch_toolchain_enabled"],
    target_triple = "aarch64-unknown-linux-gnu",
    urls = [
        "https://static.rust-lang.org/dist/{}.tar.xz",
        "https://mirrors.sjtug.sjtu.edu.cn/rust-static/dist/{}.tar.xz",
        "https://mirrors.ustc.edu.cn/rust-static/dist/{}.tar.xz",
    ],
    versions = ["1.92.0"],
)
rust.repository_set(
    name = "rust_branch_windows_x86_64",
    edition = "2024",
    exec_triple = "x86_64-pc-windows-msvc",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    target_settings = ["//:rust_branch_toolchain_enabled"],
    target_triple = "x86_64-pc-windows-msvc",
    urls = [
        "https://static.rust-lang.org/dist/{}.tar.xz",
        "https://mirrors.sjtug.sjtu.edu.cn/rust-static/dist/{}.tar.xz",
        "https://mirrors.ustc.edu.cn/rust-static/dist/{}.tar.xz",
    ],
    versions = ["1.92.0"],
)
rust.repository_set(
    name = "rust_branch_windows_aarch64",
    edition = "2024",
    exec_triple = "aarch64-pc-windows-msvc",
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:windows",
    ],
    target_settings = ["//:rust_branch_toolchain_enabled"],
    target_triple = "aarch64-pc-windows-msvc",
    urls = [
        "https://static.rust-lang.org/dist/{}.tar.xz",
        "https://mirrors.sjtug.sjtu.edu.cn/rust-static/dist/{}.tar.xz",
        "https://mirrors.ustc.edu.cn/rust-static/dist/{}.tar.xz",
    ],
    versions = ["1.92.0"],
)
rust.toolchain(
    edition = "2024",
    extra_target_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc",
    ],
    target_settings = ["//:rust_branch_toolchain_disabled"],
    urls = [
        "https://static.rust-lang.org/dist/{}.tar.xz",
        "https://mirrors.sjtug.sjtu.edu.cn/rust-static/dist/{}.tar.xz",
        "https://mirrors.ustc.edu.cn/rust-static/dist/{}.tar.xz",
    ],
    versions = ["1.94.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

