load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "loopal-tool-background",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/loopal-backend",
        "//crates/loopal-error",
        "//crates/loopal-protocol",
        "//crates/loopal-tool-api",
        "@crates//:parking_lot",
        "@crates//:tokio",
        "@crates//:tracing",
    ],
)

rust_test(
    name = "loopal-tool-background-unit-test",
    crate = ":loopal-tool-background",
    edition = "2024",
)

rust_test(
    name = "loopal-tool-background-test",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/suite.rs",
    edition = "2024",
    deps = [
        ":loopal-tool-background",
        "//crates/loopal-backend",
        "//crates/loopal-protocol",
        "//crates/loopal-tool-api",
        "//crates/tools/process/bash:loopal-tool-bash",
        "@crates//:parking_lot",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:uuid",
    ] + select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@crates//:libc"],
    }),
)
