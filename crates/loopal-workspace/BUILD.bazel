load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "loopal-workspace",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/loopal-backend",
        "//crates/loopal-git",
        "//crates/loopal-protocol",
        "//crates/loopal-storage",
        "//crates/loopal-tool-api",
        "@crates//:chrono",
        "@crates//:notify",
        "@crates//:regex",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tokio",
        "@crates//:tracing",
    ],
)

rust_test(
    name = "loopal-workspace-unit-test",
    crate = ":loopal-workspace",
    edition = "2024",
    deps = ["@crates//:tempfile"],
)

rust_test(
    name = "loopal-workspace_test",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/suite.rs",
    edition = "2024",
    deps = [
        ":loopal-workspace",
        "//crates/loopal-storage",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)
