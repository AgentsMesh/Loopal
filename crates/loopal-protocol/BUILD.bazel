load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "loopal-protocol",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/loopal-tool-invocation",
        "@crates//:chrono",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:strum",
        "@crates//:tokio",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "loopal-protocol_test",
    srcs = glob(["tests/**/*.rs"]),
    compile_data = [
        "src/control.rs",
        "src/event_payload.rs",
        "src/event_summary.rs",
        "src/permission_action.rs",
        "src/permission_decision_audit.rs",
        "src/permission_digest.rs",
        "src/permission_intent.rs",
        "src/permission_intent_wire.rs",
        "src/permission_request.rs",
        "src/permission_receipt.rs",
        "src/protected_effect_audit.rs",
        "src/workflow/capability.rs",
        "src/workflow/command.rs",
        "src/workflow/event.rs",
        "src/workflow/ids.rs",
        "src/workflow/mod.rs",
        "src/workflow/node_validation.rs",
        "src/workflow/output.rs",
        "src/workflow/planner.rs",
        "src/workflow/planner_policy.rs",
        "src/workflow/planner_schema.rs",
        "src/workflow/reducer.rs",
        "src/workflow/reducer_attempt.rs",
        "src/workflow/reducer_cancel.rs",
        "src/workflow/reducer_graph.rs",
        "src/workflow/reducer_stop.rs",
        "src/workflow/reducer_transition.rs",
        "src/workflow/request.rs",
        "src/workflow/retry.rs",
        "src/workflow/schema_validation.rs",
        "src/workflow/spec.rs",
        "src/workflow/start_lookup.rs",
        "src/workflow/state.rs",
        "src/workflow/summary.rs",
        "src/workflow/terminal.rs",
        "src/workflow/terminal_bounds.rs",
        "src/workflow/validation.rs",
