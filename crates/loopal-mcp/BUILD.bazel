load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "loopal-mcp",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    proc_macro_deps = ["@crates//:async-trait"],
    visibility = ["//visibility:public"],
    deps = [
        "//crates/loopal-backend",
        "//crates/loopal-config",
        "//crates/loopal-error",
        "//crates/loopal-ipc",
        "//crates/loopal-protocol",
        "//crates/loopal-secret-client",
        "//crates/loopal-secret-runtime",
        "//crates/loopal-tool-api",
        "@crates//:dirs",
        "@crates//:futures",
        "@crates//:indexmap",
        "@crates//:opener",
        "@crates//:regex",
        "@crates//:reqwest",
        "@crates//:rmcp",
        "@crates//:secrecy",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:zeroize",
    ],
)

rust_test(
    name = "loopal-mcp-unit-test",
    crate = ":loopal-mcp",
    edition = "2024",
    deps = ["@crates//:libc"],
)

rust_test(
    name = "loopal-mcp_test",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/suite.rs",
    edition = "2024",
    proc_macro_deps = ["@crates//:async-trait"],
    deps = [
        ":loopal-mcp",
        "//crates/loopal-config",
        "//crates/loopal-error",
        "//crates/loopal-test-support",
        "//crates/loopal-tool-api",
        "@crates//:indexmap",
        "@crates//:rmcp",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
    ],
)
