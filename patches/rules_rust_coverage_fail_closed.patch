 use std::path::PathBuf;
 use std::process;
 
+#[cfg(unix)]
+fn ensure_coverage_dir_writable(coverage_dir: &Path) {
+    use std::os::unix::fs::PermissionsExt;
+
+    let mut permissions = fs::metadata(coverage_dir)
+        .expect("Failed to inspect coverage directory permissions")
+        .permissions();
+    let mode = permissions.mode();
+    permissions.set_mode(mode | 0o200);
+    fs::set_permissions(coverage_dir, permissions)
+        .expect("Failed to make coverage directory owner-writable");
+}
+
+#[cfg(windows)]
+fn ensure_coverage_dir_writable(coverage_dir: &Path) {
+    let mut permissions = fs::metadata(coverage_dir)
+        .expect("Failed to inspect coverage directory permissions")
+        .permissions();
+    permissions.set_readonly(false);
+    fs::set_permissions(coverage_dir, permissions)
+        .expect("Failed to make coverage directory owner-writable");
+}
+
+#[cfg(not(any(unix, windows)))]
+fn ensure_coverage_dir_writable(_coverage_dir: &Path) {}
+
