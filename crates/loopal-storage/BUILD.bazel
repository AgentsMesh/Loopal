load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "loopal-storage",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/loopal-config",
        "//crates/loopal-error",
        "//crates/loopal-provider-api",
        "//crates/loopal-protocol",
        "//crates/loopal-tool-invocation",
        "//crates/loopal-turn",
        "@crates//:chrono",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:thiserror",
        "@crates//:tokio",
        "@crates//:uuid",
    ],
    proc_macro_deps = ["@crates//:async-trait"],
)

rust_test(
    name = "loopal-storage-unit-test",
    crate = ":loopal-storage",
    edition = "2024",
)

rust_test(
    name = "loopal-storage_test",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/suite.rs",
    edition = "2024",
    deps = [
        ":loopal-storage",
        "//crates/loopal-error",
        "//crates/loopal-protocol",
        "//crates/loopal-provider-api",
        "//crates/loopal-turn",
        "@crates//:chrono",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)
